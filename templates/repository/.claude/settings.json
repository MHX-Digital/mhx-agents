{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/mhx/agent-architecture-kit/bin/aak guard pretool --client claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/mhx/agent-architecture-kit/bin/aak hook prompt-submit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/mhx/agent-architecture-kit/bin/aak hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/mhx/agent-architecture-kit/bin/aak hook stop"
          }
        ]
      }
    ]
  }
}
