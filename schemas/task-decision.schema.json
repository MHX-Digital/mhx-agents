{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-decision.schema.json",
  "title": "Agent Architecture Kit - Protected Task Decision",
  "type": "object",
  "required": [
    "schemaVersion", "kitVersion", "repoId", "tier", "branch", "executor",
    "baseSha", "createdAt", "expiresAt", "verdict",
    "allowedExistingPaths", "allowedNewPaths", "protectedDomains"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kitVersion": { "type": "string" },
    "repoId": { "type": "string" },
    "tier": { "type": "integer" },
    "issue": { "type": ["integer", "null"] },
    "branch": { "type": "string" },
    "executor": { "type": "string", "enum": ["claude", "codex", "gemini"] },
    "baseSha": { "type": "string" },
    "mapHash": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "expiresAt": { "type": "string" },
    "verdict": { "type": "string" },
    "allowedExistingPaths": { "type": "array", "items": { "type": "string" } },
    "allowedNewPaths": { "type": "array", "items": { "type": "string" } },
    "protectedDomains": { "type": "array", "items": { "type": "string" } },
    "requiredValidations": { "type": "array", "items": { "type": "string" } },
    "overrideId": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
